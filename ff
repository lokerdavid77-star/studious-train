-- ESP
local espTab = win:Tab("ESP")
local espL = espTab:Section("Player ESP", "Left")
local espEnabled = false
local espConn, espGui, espFrames = nil, nil, {}
local function ensureGui()
    if espGui and espGui.Parent then return end
    espGui = Instance.new("ScreenGui"); espGui.Name = "VozoidESP"
    espGui.ResetOnSpawn = false
    pcall(function() espGui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
end
local function updateESP()
    if not espEnabled then return end
    ensureGui()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char, hrp, hum = p.Character, nil, nil
            if char then hrp = char:FindFirstChild("HumanoidRootPart"); hum = char:FindFirstChild("Humanoid") end
            if hrp and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen and pos.Z > 0 then
                    local frame = espFrames[p]
                    if not frame then
                        frame = Instance.new("Frame"); frame.BorderSizePixel = 0
                        frame.BackgroundTransparency = 0.7
                        frame.BackgroundColor3 = Color3.fromRGB(255,130,200)
                        frame.Parent = espGui; espFrames[p] = frame
                    end
                    local h = math.clamp(5000 / pos.Z, 20, 400)
                    local w = h * 0.55
                    frame.Size = UDim2.fromOffset(w, h)
                    frame.Position = UDim2.fromOffset(pos.X - w/2, pos.Y - h/2)
                    frame.Visible = true
                elseif espFrames[p] then espFrames[p].Visible = false end
            elseif espFrames[p] then espFrames[p].Visible = false end
        end
    end
end
espL:Toggle({ Name = "Enable ESP", Flag = "EspEnabled", Default = false,
    Callback = function(v)
        espEnabled = v
        if v and not espConn then espConn = RunService.RenderStepped:Connect(updateESP)
        elseif not v and espConn then
            espConn:Disconnect(); espConn = nil
            for _, f in pairs(espFrames) do f:Destroy() end
            espFrames = {}
            if espGui then espGui:Destroy(); espGui = nil end
        end
    end })
espL:ColorPicker({ Name = "Box Color", Flag = "EspColor",
    Default = Color3.fromRGB(255,130,200),
    Callback = function(c)
        for _, f in pairs(espFrames) do f.BackgroundColor3 = c end
    end })

