themeSection:ColorPicker({ Name = "Text", Flag = "Cfg_Text",
    Default = Color3.fromRGB(230, 225, 235) })

-- helper: live-apply theme colors when changed
local function applyTheme()
    ui.Theme.Bg    = ui.Flags["Cfg_Bg"]    or ui.Theme.Bg
    ui.Theme.Panel = ui.Flags["Cfg_Panel"] or ui.Theme.Panel
    ui.Theme.Accent = ui.Flags["Cfg_Accent"] or ui.Theme.Accent
    ui.Theme.Text  = ui.Flags["Cfg_Text"]  or ui.Theme.Text
end
for _, flag in ipairs({"Cfg_Bg","Cfg_Panel","Cfg_Accent","Cfg_Text"}) do
    local it = ui.Items[flag]
    if it then
        local orig = it.Set
        it.Set = function(self, v)
            orig(self, v); applyTheme()
        end
    end
end

